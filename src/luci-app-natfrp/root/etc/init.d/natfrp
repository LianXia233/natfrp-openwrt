#!/bin/sh /etc/rc.common

START=90

USE_PROCD=1

SERVICE_CWD="/etc/natfrp"
SERVICE_PATH="/usr/bin/natfrp-service"
CTL="/usr/bin/natfrpctl"

_log() {
	echo "[$1] $2"
	logger -t "natfrp" -p "daemon.$1" "$2"
}

log_info() {
	_log "info" "$1"
}

log_err() {
	_log "err" "$1"
}

start_instance() {
	[ "$1" = "main" ] || return
	[ "$CONFIG_main_enabled" = "1" ] || return

	mkdir -p "$SERVICE_CWD"

	if ! NATFRP_SERVICE_WD="$SERVICE_CWD" "$SERVICE_PATH" --help 2>/dev/null | grep -q natfrp-service; then
		log_err "invalid executable, make sure you installed correct arch [$(uname -m)]"
		return 1
	fi

	# 由 natfrpctl 把 uci 配置转换成守护进程配置（含密码派生），失败则不启动
	if ! "$CTL" render >/dev/null; then
		log_err "failed to generate $SERVICE_CWD/config.json"
		return 1
	fi

	procd_open_instance "main"

	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/natfrp

	procd_set_param command "$SERVICE_PATH" --daemon --force-root

	procd_set_param env \
		"LANG=en_US.UTF-8" \
		"NATFRP_SERVICE_WD=$SERVICE_CWD" \
		"NATFRP_FRPC_PATH=/usr/bin/natfrp-frpc" \
		"NATFRP_UPDATE_OVERRIDE=launcher-openwrt"

	procd_close_instance
}

reload_service() {
	log_info "restarting natfrp-service"
	stop
	start
}

# 关闭 WebUI TLS 时，明文入口由 natfrpctl relay 提供
start_relay() {
	[ "$CONFIG_main_enabled" = "1" ] || return
	[ "$CONFIG_main_webui" = "1" ] || return
	[ "$CONFIG_main_webui_tls" = "0" ] || return

	procd_open_instance "webui-http"
	procd_set_param respawn
	procd_set_param file /etc/config/natfrp
	procd_set_param command "$CTL" relay
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger natfrp
}

start_service() {
	config_load natfrp
	config_foreach start_instance natfrp
	start_relay
}