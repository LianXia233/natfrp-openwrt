config natfrp 'main'
	option enabled '0'

	# 远程管理默认关闭；开启后才会向外建立 WSS 长连接
	option remote_mgmt '0'

	# 默认不允许远程改配置/触发更新：上游 E2E 密钥是固定盐 + 1 万次 PBKDF2，
	# 密码一旦泄露，这两项就是持久化入口。需要时再显式打开。
	option remote_allow_config '0'
	option remote_allow_update '0'

	# WebUI 默认对外（LAN）监听，端口用启动器的常规端口
	option webui '1'
	option webui_host '0.0.0.0'
	option webui_port '4101'

	# 默认走 HTTPS（natfrpctl 生成带 SAN、825 天的证书，页面提供「下载证书」按钮）；
	# 改成 0 会切换成明文入口，口令将以明文传输，仅建议在可信内网使用。
	option webui_tls '1'
